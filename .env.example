NODE_ENV=production
RUNTIME_ROLE=api
HOST=0.0.0.0
PORT=7111
TRUST_PROXY_HOPS=1
HTTP_KEEP_ALIVE_TIMEOUT_MS=65000
HTTP_HEADERS_TIMEOUT_MS=66000
HTTP_REQUEST_TIMEOUT_MS=300000
HTTP_MAX_HEADERS_COUNT=200
GRACEFUL_SHUTDOWN_DRAIN_MS=5000
GRACEFUL_SHUTDOWN_TIMEOUT_MS=30000

DATABASE_URL=postgresql://<runtime_user>:<runtime_password>@<db_host>:5432/<db_name>?schema=public
DATABASE_SYSTEM_URL=postgresql://<system_user>:<system_password>@<db_host>:5432/<db_name>?schema=public
MIGRATION_DATABASE_URL=postgresql://<migration_user>:<migration_password>@<db_host>:5432/<db_name>?schema=public
# Alternatif secret store/systemd credentials (jangan isi bersamaan dengan nilai di atas):
# DATABASE_URL_FILE=/run/credentials/ruwang-arsip-api/DATABASE_URL
# DATABASE_SYSTEM_URL_FILE=/run/credentials/ruwang-arsip-api/DATABASE_SYSTEM_URL
# MIGRATION_DATABASE_URL_FILE=/run/credentials/ruwang-arsip-api/MIGRATION_DATABASE_URL
DATABASE_RUNTIME_ROLE=ruwang_arsip_app
DATABASE_SYSTEM_ROLE=ruwang_arsip_system
DB_REQUIRE_LEAST_PRIVILEGE=true
DB_REQUIRE_RLS=true
# Daftar minimum sudah dikunci oleh aplikasi; gunakan variabel ini hanya untuk
# menambahkan tabel deployment-specific, bukan untuk mengurangi cakupan bawaan.
DB_RLS_REQUIRED_TABLES=
DB_POOL_MIN=0
DB_POOL_MAX=10
DB_WORKER_POOL_MAX=3
DB_SYSTEM_POOL_MAX=3
DB_CONNECTION_TIMEOUT_MS=5000
DB_POOL_IDLE_TIMEOUT_MS=30000
DB_STATEMENT_TIMEOUT_MS=30000
DB_QUERY_TIMEOUT_MS=35000
DB_LOCK_TIMEOUT_MS=5000
DB_IDLE_TRANSACTION_TIMEOUT_MS=30000
DB_SLOW_QUERY_THRESHOLD_MS=1000
DB_MAINTENANCE_REPORT_LIMIT=50
RETENTION_REPORT_BUCKET_DAYS=30,90,180,365

JWT_SECRET=<generate-and-store-a-unique-secret>
JWT_REFRESH_SECRET=<generate-and-store-a-different-unique-secret>
# Alternatif secrets manager/systemd credentials: kosongkan nilai langsung di atas,
# lalu aktifkan JWT_SECRET_FILE=/run/credentials/ruwang-arsip-api/JWT_SECRET
# dan JWT_REFRESH_SECRET_FILE=/run/credentials/ruwang-arsip-api/JWT_REFRESH_SECRET
JWT_EXPIRES_IN=1d
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

FILE_ACCESS_SECRET=<generate-and-store-a-file-access-secret>
# FILE_ACCESS_SECRET_FILE=/run/credentials/ruwang-arsip-api/FILE_ACCESS_SECRET
FILE_ACCESS_TOKEN_EXPIRES_IN=15m

AUTH_REFRESH_COOKIE_NAME=ruang_arsip_refresh_token
AUTH_COOKIE_SAME_SITE=lax
AUTH_COOKIE_DOMAIN=

FRONTEND_URL=https://arsip.example.com

CORS_ORIGIN=https://arsip.example.com

PUBLIC_BASE_URL=https://api.arsip.example.com
API_BASE_URL=https://api.arsip.example.com/api/v1
API_DOCS_ENABLED=true
HEALTH_CHECK_TIMEOUT_MS=1500
HEALTH_CHECK_CACHE_MS=3000
LOG_LEVEL=info
LOG_MAX_STRING_LENGTH=16384
HTTP_ACCESS_LOG_ENABLED=true
HTTP_ACCESS_LOG_HEALTH=false
INFRA_ERROR_LOG_INTERVAL_MS=60000
OTEL_ENABLED=false
# Kosongkan agar nama service otomatis mengikuti RUNTIME_ROLE.
OTEL_SERVICE_NAME=
# Diisi saat collector VPS tersedia, contoh http://127.0.0.1:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1

UPLOAD_DIR=/var/lib/ruwang-arsip/uploads
UPLOAD_TEMP_DIR=/var/lib/ruwang-arsip/uploads/tmp/uploads
UPLOAD_TEMP_TTL_MS=86400000
UPLOAD_TEMP_CLEANUP_INTERVAL_MS=3600000
STORAGE_MIN_FREE_BYTES=1073741824
STORAGE_MIN_FREE_PERCENT=5
STORAGE_MIN_FREE_INODES=1000
REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL_FILE=/run/credentials/ruwang-arsip-api/REDIS_URL
# Kosongkan untuk memakai REDIS_URL. Queue boleh memakai Redis terpisah.
JOB_QUEUE_REDIS_URL=
# JOB_QUEUE_REDIS_URL_FILE=/run/credentials/ruwang-arsip-api/JOB_QUEUE_REDIS_URL
JOB_QUEUE_REDIS_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_STORE=redis
# Isi salah satu. RATE_LIMIT_REDIS_URL boleh dikosongkan untuk memakai REDIS_URL.
RATE_LIMIT_REDIS_URL=
# RATE_LIMIT_REDIS_URL_FILE=/run/credentials/ruwang-arsip-api/RATE_LIMIT_REDIS_URL
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_MS=5000
RATE_LIMIT_KEY_SECRET=<generate-and-store-a-rate-limit-secret>
# RATE_LIMIT_KEY_SECRET_FILE=/run/credentials/ruwang-arsip-api/RATE_LIMIT_KEY_SECRET
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=300
UPLOAD_RATE_LIMIT_WINDOW_MS=900000
UPLOAD_RATE_LIMIT_MAX=60
FILE_ACCESS_RATE_LIMIT_WINDOW_MS=60000
FILE_ACCESS_RATE_LIMIT_MAX=300
DOWNLOAD_RATE_LIMIT_WINDOW_MS=900000
DOWNLOAD_RATE_LIMIT_MAX=300
IMPORT_RATE_LIMIT_WINDOW_MS=3600000
IMPORT_RATE_LIMIT_MAX=20
EXPORT_RATE_LIMIT_WINDOW_MS=3600000
EXPORT_RATE_LIMIT_MAX=120
REPORT_RATE_LIMIT_WINDOW_MS=300000
REPORT_RATE_LIMIT_MAX=120
CLIENT_ERROR_REPORT_RATE_LIMIT_WINDOW_MS=300000
CLIENT_ERROR_REPORT_RATE_LIMIT_MAX=30
EXPENSIVE_OPERATION_RATE_LIMIT_WINDOW_MS=3600000
EXPENSIVE_OPERATION_RATE_LIMIT_MAX=10
APP_CACHE_ENABLED=true
# Kosongkan untuk memakai REDIS_URL. Namespace cache tetap terpisah dari queue dan rate limit.
APP_CACHE_REDIS_URL=
# APP_CACHE_REDIS_URL_FILE=/run/credentials/ruwang-arsip-api/APP_CACHE_REDIS_URL
APP_CACHE_KEY_PREFIX=ruwang-arsip:cache
APP_CACHE_CONNECT_TIMEOUT_MS=1000
APP_CACHE_TTL_MS=60000
APP_CACHE_TTL_JITTER_PERCENT=10
APP_CACHE_MAX_ENTRY_BYTES=262144
APP_CACHE_LOCK_TTL_MS=5000
APP_CACHE_WAIT_TIMEOUT_MS=1000
APP_CACHE_WAIT_INTERVAL_MS=50
SLIK_IMPORT_QUEUE_ENABLED=true
SLIK_IMPORT_LOCAL_FALLBACK_ENABLED=false
SLIK_IMPORT_REQUIRE_WORKER=true
SLIK_IMPORT_WORKER_CONCURRENCY=1
WORKER_SHUTDOWN_TIMEOUT_MS=120000
WORKER_HEARTBEAT_KEY_PREFIX=ruwang-arsip:worker-heartbeat
WORKER_HEARTBEAT_INTERVAL_MS=5000
WORKER_HEARTBEAT_TTL_MS=15000
WORKER_HEARTBEAT_REDIS_CONNECT_TIMEOUT_MS=1000
SLIK_IMPORT_MAX_FILE_SIZE_MB=500
SLIK_IMPORT_MAX_TOTAL_SIZE_MB=1000
SLIK_IMPORT_MAX_ROWS=1000000
SLIK_IMPORT_BATCH_SIZE=1000
SLIK_IMPORT_MAX_ERROR_SAMPLES=50
JSON_BODY_LIMIT=1mb
URLENCODED_BODY_LIMIT=1mb
DOCUMENT_UPLOAD_MAX_TOTAL_SIZE_MB=100
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_IP_RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=25
AUTH_REFRESH_RATE_LIMIT_MAX=1000
STORAGE_USAGE_SOURCE=database_file_size
STORAGE_USAGE_REMOTE_HEAD_ENABLED=false
STORAGE_USAGE_REMOTE_HEAD_TIMEOUT_MS=3000
WATERMARK_MAX_PROCESS_SIZE_BYTES=536870912
WATERMARK_PROCESSING_MODE=worker
WATERMARK_WORKER_POLL_INTERVAL_MS=2000
WATERMARK_WORKER_BATCH_SIZE=1
WATERMARK_PROCESSING_STALE_MS=21600000

ALLOW_PRODUCTION_SEED=false

SEED_ADMIN_NAME=Administrator
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@example.invalid
SEED_ADMIN_PASSWORD=<set-via-secret-store>
SEED_ADMIN_ROLE=Admin
SEED_ADMIN_DIVISION=IT
SEED_ADMIN_PHONE=
SEED_ADMIN_CAN_ACCESS_RESTRICTED_DOCUMENTS=true

SEED_RESET_EXISTING_PASSWORDS=false

SEED_USERS_JSON=
API_TEST_ADMIN_USERNAME=
API_TEST_ADMIN_PASSWORD=
FULLSTACK_FRONTEND_URL=http://localhost:3000
FULLSTACK_FRONTEND_DIR=
FULLSTACK_BACKEND_HEALTH_URL=http://127.0.0.1:7111/health
FULLSTACK_REUSE_FRONTEND_BUILD=false
E2E_BACKEND_NODE_ENV=development
QUALITY_GATE_REPORT_DIR=quality-reports
QUALITY_GATE_BACKEND_TIMEOUT_MS=600000
QUALITY_GATE_FRONTEND_TIMEOUT_MS=1800000
QUALITY_GATE_FULLSTACK_TIMEOUT_MS=600000
QUALITY_GATE_PERFORMANCE_TIMEOUT_MS=300000
QUALITY_GATE_HEARTBEAT_MS=30000

# STEP 10 release readiness. Isi saat deployment VPS; script ini tidak deploy.
RELEASE_FRONTEND_DIR=
RELEASE_VERIFY_FRONTEND_URL=
RELEASE_VERIFY_API_HEALTH_URL=
RELEASE_VERIFY_API_READY_URL=
RELEASE_VERIFY_TIMEOUT_MS=5000
RELEASE_VERIFY_ALLOW_LOOPBACK=false
RELEASE_REPORT_DIR=release-reports

# Load test lokal. Target sengaja dibatasi ke loopback oleh runner.
LOAD_TEST_BASE_URL=http://127.0.0.1:7211
LOAD_TEST_REPORT_DIR=performance-reports
# Override berikut opsional. Tanpa threshold, runner hanya mencatat baseline.
LOAD_TEST_CONCURRENCY=
LOAD_TEST_DURATION_MS=
LOAD_TEST_WARMUP_MS=
LOAD_TEST_REQUEST_TIMEOUT_MS=
LOAD_TEST_MAX_REQUESTS=
LOAD_TEST_MAX_ERROR_RATE_PERCENT=
LOAD_TEST_MAX_P95_MS=
LOAD_TEST_MIN_REQUESTS_PER_SECOND=

AUTH_INVITE_EXPIRES_HOURS=72
AUTH_RESET_PASSWORD_EXPIRES_HOURS=2

RESEND_API_KEY=<set-via-secret-store>
# RESEND_API_KEY_FILE=/run/credentials/ruwang-arsip-api/RESEND_API_KEY
RESEND_FROM_EMAIL=no-reply@example.invalid
RESEND_FROM_NAME=Ruwang Arsip
