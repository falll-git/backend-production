    "uuid": "11.1.1",
    "mysql2": "3.24.3",
    "qs": "6.16.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4"
  }
