    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-node": "^0.221.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "@prisma/adapter-pg": "7.9.0",
    "@prisma/client": "7.9.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.77.6",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.0",
    "joi": "18.2.1",
    "joi-to-swagger": "^6.2.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "pdf-lib": "^1.17.1",
    "pg": "8.18.0",
    "pino": "^10.3.1",
    "prisma": "7.9.0",
    "resend": "^6.12.3",
    "sharp": "0.35.3",
    "swagger-ui-express": "^5.0.1"
  },
  "overrides": {
    "@prisma/dev": {
      "valibot": "1.4.2"
    },
    "exceljs": {
      "archiver": "8.0.0",
      "unzipper": "0.12.5"
    },
    "brace-expansion": "5.0.9",
    "deepmerge-ts": "8.0.1",
    "fast-uri": "3.1.7",
