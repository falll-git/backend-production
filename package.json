{
  "name": "be-ruwang-arsip",
  "version": "1.0.0",
  "main": "src/server.js",
  "engines": {
    "node": "^22.12 || 24.x"
  },
  "scripts": {
    "start": "node src/server.js",
    "worker:slik-import": "node src/workers/slik-import.worker.js",
    "worker:watermark": "node src/workers/watermark.worker.js",
    "worker:seputar-jaminan": "node src/workers/seputar-jaminan.worker.js",
    "dev": "nodemon src/server.js",
    "build": "node scripts/check-js-syntax.js",
    "test": "node --test",
    "test:integration": "node scripts/run-api-integration-tests.js",
    "test:fullstack": "playwright test --config=playwright.fullstack.config.js",
    "test:load-smoke": "node scripts/run-performance.js --profile=smoke",
    "performance:baseline": "node scripts/run-performance.js --profile=baseline",
    "audit:dependencies": "npm audit --audit-level=high",
    "ci:verify-workflow": "node scripts/verify-ci-workflow.mjs",
    "quality": "npm run ci:verify-workflow && npm run release:contract && npm run config:production:validate && npm run prisma:generate && npm run build && npm test && npm run test:integration && npm run database:rls-verify && npm run audit:dependencies",
    "quality:fullstack": "npm run quality && npm run test:fullstack",
    "quality:release": "node scripts/release-quality-gate.js",
    "test:ideb-report": "node --test src/utils/ideb-report.test.js",
    "test:slik-reference": "node --test src/utils/slik-reference-dictionary.test.js",
    "check:slik-reference-coverage": "node scripts/check-slik-reference-coverage.js",
    "storage:reconcile": "node scripts/reconcile-storage.js",
    "storage:cleanup-temp": "node scripts/cleanup-temporary-files.js",
    "database:report": "node scripts/database-maintenance-report.js",
    "database:security-report": "node scripts/database-security-report.js",
    "database:rls-verify": "node scripts/verify-rls-isolation.js",
    "database:migration-paths-verify": "node scripts/verify-migration-upgrade-paths.js",
    "retention:report": "node scripts/retention-report.js",
    "release:contract": "node scripts/verify-release-contract.js",
    "config:production:validate": "node --test src/config/production-contract.test.js",
    "release:preflight": "node scripts/production-preflight.js",
    "release:verify": "node scripts/verify-production-release.js",
    "release:atomic:init": "node scripts/initialize-atomic-release.js",
    "release:atomic:manifest": "node scripts/create-release-manifest.js",
    "release:atomic:preflight": "node scripts/preflight-atomic-release.js",
    "release:atomic:switch": "node scripts/switch-atomic-release.js",
    "release:atomic:rollback": "node scripts/rollback-atomic-release.js",
    "release:atomic:simulate": "node scripts/simulate-atomic-deployment.js",
    "release:pm2:verify": "node scripts/verify-pm2-release.js",
    "release:nginx:render": "node scripts/render-nginx-release.js",
    "prisma:generate": "prisma generate",
    "migrate:status": "prisma migrate status",
    "migrate:deploy": "prisma migrate deploy",
    "apply:server": "prisma migrate deploy && node prisma/seed-system.js",
    "sync:role-menu-baseline": "node scripts/sync-role-menu-baseline.js",
    "sync:seputar-jaminan-contracts": "node scripts/sync-seputar-jaminan-contracts.js",
    "seed:system": "node prisma/seed-system.js",
    "seed:ci-test-data": "node scripts/seed-ci-test-data.js && node scripts/seed-ci-seputar-jaminan.js",
    "ci:provision-runtime-role": "node scripts/provision-ci-runtime-role.js",
    "fixture:modal-workflows": "node scripts/modal-workflow-fixtures.js",
    "seed": "prisma db seed"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
