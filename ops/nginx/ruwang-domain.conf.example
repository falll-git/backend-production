log_format ruwang___RUWANG_DOMAIN__ escape=json
    '{"time":"$time_iso8601","msec":"$msec",'
    '"domain":"$server_name","request_id":"$request_id",'
    '"connection":"$connection","connection_requests":"$connection_requests",'
    '"method":"$request_method","path":"$uri","protocol":"$server_protocol",'
    '"status":$status,"bytes_sent":$body_bytes_sent,"request_length":$request_length,'
    '"request_time":"$request_time","upstream":"$upstream_addr",'
    '"action_not_found":"$upstream_http_x_nextjs_action_not_found",'
    '"upstream_status":"$upstream_status","upstream_connect_time":"$upstream_connect_time",'
    '"upstream_header_time":"$upstream_header_time","upstream_response_time":"$upstream_response_time"}';

server {
    listen 80;
    listen [::]:80;
    server_name __RUWANG_DOMAIN__;
    access_log /var/log/nginx/ruwang-__RUWANG_DOMAIN__-access.log ruwang___RUWANG_DOMAIN__;
    error_log /var/log/nginx/ruwang-__RUWANG_DOMAIN__-error.log warn;
    add_header X-Request-ID $request_id always;
    return 301 https://__RUWANG_DOMAIN__$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __RUWANG_DOMAIN__;
    access_log /var/log/nginx/ruwang-__RUWANG_DOMAIN__-access.log ruwang___RUWANG_DOMAIN__;
    error_log /var/log/nginx/ruwang-__RUWANG_DOMAIN__-error.log warn;
    add_header X-Request-ID $request_id always;

    ssl_certificate __TLS_CERTIFICATE_PATH__;
    ssl_certificate_key __TLS_CERTIFICATE_KEY_PATH__;

    location /api/ {
        client_max_body_size 1g;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host __RUWANG_DOMAIN__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_hide_header X-Request-ID;
        proxy_connect_timeout 10s;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
        proxy_pass http://127.0.0.1:__RUWANG_API_PORT__;
    }

    location / {
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host __RUWANG_DOMAIN__;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Request-ID $request_id;
        proxy_hide_header X-Request-ID;
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        proxy_pass http://127.0.0.1:__RUWANG_FRONTEND_PORT__;
    }

    location ~ /\. {
        deny all;
    }
}
